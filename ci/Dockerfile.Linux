FROM ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake g++ git ninja-build \
    file patchelf wget ca-certificates \
    qt6-base-dev \
    qt6-declarative-dev \
    qml6-module-qt-labs-qmlmodels \
    qml6-module-qtqml-workerscript \
    qml6-module-qtquick \
    qml6-module-qtquick-controls \
    qml6-module-qtquick-dialogs \
    qml6-module-qtquick-templates \
    qml6-module-qtquick-layouts \
    qml6-module-qtquick-window \
    qt6-tools-dev-tools \
    qt6-svg-dev qt6-tools-dev \
    qt6-declarative-dev-tools \
    libxkbcommon-dev \
    librsvg2-bin \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/lib/qt6/libexec/qmlimportscanner /usr/lib/qt6/bin/qmlimportscanner

# Download and extract linuxdeploy + Qt plugin so they run without FUSE.
# AppImages are extracted via --appimage-extract (uses bundled unsquashfs,
# no FUSE required) then symlinked into PATH.
RUN ARCH=$(uname -m) && \
    wget -q "https://github.com/linuxdeploy/linuxdeploy/releases/download/continuous/linuxdeploy-${ARCH}.AppImage" \
        -O /tmp/linuxdeploy.AppImage && \
    chmod +x /tmp/linuxdeploy.AppImage && \
    cd /tmp && /tmp/linuxdeploy.AppImage --appimage-extract && \
    mv /tmp/squashfs-root /opt/linuxdeploy && \
    wget -q "https://github.com/linuxdeploy/linuxdeploy-plugin-qt/releases/download/continuous/linuxdeploy-plugin-qt-${ARCH}.AppImage" \
        -O /tmp/linuxdeploy-plugin-qt.AppImage && \
    chmod +x /tmp/linuxdeploy-plugin-qt.AppImage && \
    cd /tmp && /tmp/linuxdeploy-plugin-qt.AppImage --appimage-extract && \
    mv /tmp/squashfs-root /opt/linuxdeploy-plugin-qt && \
    ln -s /opt/linuxdeploy/AppRun /usr/local/bin/linuxdeploy && \
    ln -s /opt/linuxdeploy-plugin-qt/AppRun /usr/local/bin/linuxdeploy-plugin-qt && \
    rm /tmp/linuxdeploy.AppImage /tmp/linuxdeploy-plugin-qt.AppImage

# Allow git to work on mounted volumes owned by any user
RUN git config --system safe.directory '*'

# Create a non-root build user
RUN useradd -m builder
USER builder
WORKDIR /workdir

CMD ["/bin/bash"]
